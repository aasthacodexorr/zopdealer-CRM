{
    "name": "zopmedia/zopdealer",
    "type": "project",
    "description": "This is an automotive dealership SaaS web application.",
    "homepage": "https://codeigniter.com",
    "license": "MIT",
    "require": {
        "php": ">=7.4",
        "codeigniter4/framework": "4.0.4",
        "predis/predis": "^1.1",
        "nesbot/carbon": "^2.32",
        "intervention/image": "^2.5",
        "php-amqplib/php-amqplib": "^2.11",
        "google/recaptcha": "^1.2",
        "phpmailer/phpmailer": "^6.1",
        "knplabs/knp-snappy": "^1.2",
        "h4cc/wkhtmltoimage-amd64": "0.12.x",
        "h4cc/wkhtmltopdf-amd64": "0.12.x",
        "mikehaertl/php-pdftk": "^0.9.2",
        "platformcommunity/bunnycdn-storage": "^0.2.0",
        "twilio/sdk": "^6.21",
        "phpoffice/phpspreadsheet": "^1.17",
        "mpdf/mpdf": "^8.0",
        "firebase/php-jwt": "^6.10",
        "php-imap/php-imap": "^4.1",
        "spatie/array-to-xml": "^2.15",
        "stolt/json-lines": "^2.1",
        "maennchen/zipstream-php": "^2.1",
        "ralouphie/mimey": "^2.1",
        "hugsbrugs/php-sftp": "^1.1",
        "hugsbrugs/php-ftp": "^1.0",
        "facebook/graph-sdk": "^5.7",
        "stripe/stripe-php": "^8.12",
        "facebook/php-business-sdk": "14.0.*",
        "google/apiclient": "^2.12",
        "soundasleep/html2text": "^2.1",
        "gregwar/captcha": "^1.2",
        "guzzlehttp/guzzle": "^7.0",
        "clue/ndjson-react": "^1.3",
        "google/cloud-storage": "1.39.0",
        "ext-json": "*"
    },
    "require-dev": {
        "mikey179/vfsstream": "1.6.*",
      
        "mockery/mockery": "1.3.4",
        "fzaninotto/faker": "^1.9"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "scripts": {
        "test": "phpunit",
        "post-update-cmd": [
            "@composer dump-autoload"
        ],
        "pre-autoload-dump": "Google\\Task\\Composer::cleanup"
    },
    "support": {
        "forum": "http://forum.codeigniter.com/",
        "source": "https://github.com/codeigniter4/CodeIgniter4",
        "slack": "https://codeigniterchat.slack.com"
    },
    "extra": {
        "google/apiclient-services": [
            "MyBusinessAccountManagement",
            "MyBusinessBusinessInformation"
        ]
    }    
}
